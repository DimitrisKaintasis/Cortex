{
  "vector_store": {
    "provider": "qdrant",
    "config": {
      "collection_name": "data_retrieval_longmemeval_dev20_v1",
      "path": "artifacts/longmemeval-dev20-mem0-qdrant",
      "on_disk": true,
      "embedding_model_dims": 1024
    }
  },
  "history_db_path": "artifacts/longmemeval-dev20-mem0-history.sqlite3",
  "llm": {
    "provider": "ollama",
    "config": {
      "model": "qwen3.5:4b",
      "temperature": 0.1,
      "ollama_base_url": "http://127.0.0.1:11435"
    }
  },
  "embedder": {
    "provider": "ollama",
    "config": {
      "model": "qwen3-embedding:0.6b",
      "ollama_base_url": "http://127.0.0.1:11435"
    }
  }
}
